# Copy to .env.hostinger on the Hostinger GPU server.
# Never commit the real token.

VOICEBOX_API_TOKEN=replace-with-a-long-random-secret
VOICE_ENGINE_ROOT=/opt/swade-voice
CUDA_VISIBLE_DEVICES=0
LOG_LEVEL=info
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Add only the frontends that should call the Voice Engine directly.
# Prefer server-to-server calls through SSSBrain where possible.
VOICEBOX_CORS_ORIGINS=https://sssbrain.live,https://blacktales.online
