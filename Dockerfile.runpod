# SWADE Voice Engine — RunPod serverless worker image.
#
# BASE_IMAGE is the Voicebox engine built from THIS repository's Dockerfile (backend v0.5.0:
# Chatterbox, Chatterbox Turbo, Qwen3-TTS, LuxTTS, Kokoro, Whisper), pinned by digest by the
# runpod-image workflow. Its torch comes from PyPI, which on Linux is the CUDA build, so the same
# image runs on RunPod GPUs. Do not point this at ghcr.io/jamiepine/voicebox:latest-cuda: that
# image dates from 2026-02-03 (before Chatterbox and LuxTTS were added in v0.2.1).
#
# The handler is baked in, so a cold start downloads nothing from swadebase.cloud or GitHub.
# Model weights live on the RunPod network volume (populate once with {"op": "preload"}).
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root
# requests already ships with the engine image; runpod pulls in what it needs.
RUN pip install --no-cache-dir --root-user-action=ignore runpod==1.12.0

COPY ops/runpod/handler.py /app/runpod_handler.py

ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    PYTHONUNBUFFERED=1

WORKDIR /app
ENTRYPOINT []
CMD ["python", "-u", "/app/runpod_handler.py"]
